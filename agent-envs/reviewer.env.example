# GitHub App credentials for the reviewer bot.
# Copy to ~/.secrets/agents/reviewer.env, fill in real values, then chmod 600.

APP_ID="234567"
INSTALLATION_ID="89012345"
BOT_USER_ID="67890123"
APP_SLUG="myagent-reviewer"
PRIVATE_KEY_PATH="$HOME/.secrets/keys/reviewer.pem"
REPO_URL="https://github.com/your-org/your-repo.git"
