# GitHub App credentials for the implementer bot.
# Copy to ~/.secrets/agents/implementer.env, fill in real values, then chmod 600.
#
# All six variables are required by agent-git-setup.sh.

# App ID — shown on the App's settings page (GitHub → Settings → Developer
# Settings → GitHub Apps → <your app>).
APP_ID="123456"

# Installation ID — after installing the App on your repo, the URL becomes
# .../settings/installations/12345678. Use the trailing number.
INSTALLATION_ID="78901234"

# Bot user ID — fetch via:
#   curl -s https://api.github.com/users/myagent-implementer%5Bbot%5D | jq .id
# (%5B and %5D are URL-encoded [ and ].)
BOT_USER_ID="56789012"

# App slug — URL-friendly form of the App name. Confirm at
# https://github.com/apps/<slug>. Used to construct the bot's commit author.
APP_SLUG="myagent-implementer"

# Path to the private key (.pem) generated on the App's settings page.
PRIVATE_KEY_PATH="$HOME/.secrets/keys/implementer.pem"

# HTTPS clone URL of the repo this identity will commit to.
REPO_URL="https://github.com/your-org/your-repo.git"
